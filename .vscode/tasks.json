{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lint Zig",
      "type": "process",
      "command": "zlint",
      "args": [
        "--config",
        "${workspaceFolder}/zlint.json",
        "--format",
        "github",
        ".",
      ],
      "options": {
        "cwd": "${workspaceFolder}",
      },
      "problemMatcher": {
        "owner": "zlint",
        "fileLocation": [
          "relative",
          "${workspaceFolder}",
        ],
        "pattern": {
          "regexp": "^::(error|warning|notice) file=(.*),line=(\\d+),col=(\\d+),title=([^:]*)::(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "code": 5,
          "message": 6,
        },
      },
      "group": {
        "kind": "test",
        "isDefault": false,
      },
      "presentation": {
        "panel": "shared",
        "reveal": "silent",
        "revealProblems": "onProblem",
        "clear": true,
      },
    },
    {
      "label": "Lint Zig (strict)",
      "type": "process",
      "command": "zlint",
      "args": [
        "--config",
        "${workspaceFolder}/zlint.json",
        "--format",
        "github",
        "--deny-warnings",
        ".",
      ],
      "options": {
        "cwd": "${workspaceFolder}",
      },
      // Shares the "zlint" owner with the other lint tasks so that any one
      // pass replaces the whole problem set. Separate owners would list every
      // finding twice and leave the fixed ones behind until each task re-runs.
      "problemMatcher": {
        "owner": "zlint",
        "fileLocation": [
          "relative",
          "${workspaceFolder}",
        ],
        "pattern": {
          "regexp": "^::(error|warning|notice) file=(.*),line=(\\d+),col=(\\d+),title=([^:]*)::(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "code": 5,
          "message": 6,
        },
      },
      "group": {
        "kind": "test",
        "isDefault": false,
      },
      "presentation": {
        "panel": "shared",
        "reveal": "silent",
        "revealProblems": "onProblem",
        "clear": true,
      },
    },
    // Long-lived lint watcher. Every pass is bracketed by begin/end markers so
    // the background problem matcher below replaces its previous diagnostics,
    // which is what makes a fixed finding disappear from the Problems panel
    // without re-running anything manually.
    {
      "label": "Lint Zig (watch)",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/tools/zlint_watch.py",
        "--config",
        "${workspaceFolder}/zlint.json",
      ],
      "options": {
        "cwd": "${workspaceFolder}",
      },
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
      },
      "problemMatcher": {
        "owner": "zlint",
        "fileLocation": [
          "relative",
          "${workspaceFolder}",
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^zlint-watch: begin$",
          "endsPattern": "^zlint-watch: end$",
        },
        "pattern": {
          "regexp": "^::(error|warning|notice) file=(.*),line=(\\d+),col=(\\d+),title=([^:]*)::(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "code": 5,
          "message": 6,
        },
      },
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "clear": true,
        "close": false,
      },
    },
    // {
    //   "label": "Build Kernel",
    //   "type": "shell",
    //   "command": "zig build",
    //   "isBackground": false,
    //   "presentation": {
    //     "panel": "shared",
    //     "revealProblems": "onProblem",
    //     "clear": true,
    //     "close": true,
    //   },
    // },
    {
      "label": "Run QEMU (x86-32)",
      "type": "shell",
      "command": "zig build run -Darch=x86_32",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "clear": true,
      },
    },
    {
      "label": "Run QEMU (x86-64)",
      "type": "shell",
      "command": "zig build run -Darch=x86_64",
      "presentation": {
        "panel": "dedicated",
        "reveal": "always",
        "clear": true,
      },
    },
    // {
    //   "label": "Debug Kernel",
    //   "type": "shell",
    //   "command": "",
    //   "isBackground": false,
    //   "dependsOn": [
    //     "Build Kernel",
    //     "Run QEMU",
    //   ],
    //   "dependsOrder": "sequence",
    //   "presentation": {
    //     "panel": "new",
    //     "revealProblems": "onProblem",
    //     "clear": true,
    //     "close": true,
    //   },
    // },
    {
      "label": "Kill QEMU",
      "type": "shell",
      "command": "pkill -F .qemu.pid || true",
      "presentation": {
        "panel": "dedicated",
        "reveal": "silent",
        "close": true,
      },
    }
  ],
}